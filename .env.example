# 로컬 개발용 환경변수 템플릿. 복사해서 .env 로 만든 뒤 실제 값을 채웁니다.
# cp .env.example .env

# 카카오 OAuth
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=http://localhost:3000/auth/kakao/callback
KAKAO_CLIENT_SECRET=

# JWT 서명 키 (HS256, 최소 32바이트). 아래 명령으로 생성:
#   openssl rand -base64 48
# 운영 환경에서는 반드시 로컬과 다른 값을 사용합니다.
SECURITY_JWT_SECRET=

# 액세스 토큰 만료(초). 미지정 시 3600
# SECURITY_JWT_ACCESS_TOKEN_EXPIRY_SECONDS=3600

# CORS 허용 오리진 (콤마 구분). 미지정 시 http://localhost:3000,http://localhost:5173
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.example.com
